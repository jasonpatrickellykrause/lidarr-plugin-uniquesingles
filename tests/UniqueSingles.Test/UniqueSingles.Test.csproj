<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(PluginTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Allow running on .NET 10 SDK when .NET 8 runtime is not installed -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- AssemblySmokeTests reads this to check the plugin references the Lidarr version this build pinned -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LidarrAssemblyVersion</_Parameter1>
      <_Parameter2>$(LidarrAssemblyVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="SingleCleanupServiceTests.cs" />
    <Compile Include="Matching/TrackMatcherTests.cs" />
    <Compile Include="SingleCleanupOptionsTests.cs" />
    <Compile Include="UniqueSinglesImportCoordinatorTests.cs" />
    <Compile Include="UniqueSinglesNotificationTests.cs" />
    <Compile Include="ScheduledTaskServiceTests.cs" />
    <Compile Include="UniqueSinglesScanTaskTests.cs" />
    <Compile Include="AssemblySmokeTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UniqueSingles\UniqueSingles.csproj" />
    <ProjectReference Include="..\..\ext\Lidarr\src\Lidarr.Api.V1\Lidarr.Api.V1.csproj" />
    <ProjectReference Include="..\..\ext\Lidarr\src\Lidarr.Http\Lidarr.Http.csproj" />
  </ItemGroup>
</Project>
