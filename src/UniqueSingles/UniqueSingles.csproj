<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(PluginTargetFramework)</TargetFramework>
    <RootNamespace>NzbDrone.Core</RootNamespace>
    <AssemblyName>Lidarr.Plugin.$(MSBuildProjectName)</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- CI passes PluginVersion (the release tag) so Lidarr sees the real installed version. -->
    <Version Condition="'$(PluginVersion)' != ''">$(PluginVersion)</Version>
    <Version Condition="'$(Version)' == ''">1.1.0</Version>
    <!-- Lidarr parses InformationalVersion with System.Version; a "+<commit>" suffix makes it fall back to 1.0.2.0. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Disable analyzers inherited from Lidarr's Directory.Build.props -->
    <EnableAnalyzers>false</EnableAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <Import Project="../../LidarrReferences.targets" />

  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleasePackageDir>$(IntermediateOutputPath)package/</ReleasePackageDir>
    </PropertyGroup>
    <RemoveDir Directories="$(ReleasePackageDir)" />
    <MakeDir Directories="$(ReleasePackageDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ReleasePackageDir)" />
    <ZipDirectory SourceDirectory="$(ReleasePackageDir)" DestinationFile="$(TargetDir)$(TargetName).$(TargetFramework).zip" Overwrite="true" />
  </Target>

</Project>
